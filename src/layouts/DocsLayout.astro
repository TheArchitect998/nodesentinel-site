---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { docsNavigation, flatDocsNavigation } from '../data/navigation';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentIndex = flatDocsNavigation.findIndex((item) => item.href === Astro.url.pathname);
const previous = flatDocsNavigation[currentIndex - 1];
const next = flatDocsNavigation[currentIndex + 1];
---

<BaseLayout title={`${title} · NodeSentinel Dokumentation`} description={description}>
  <div class="docs-topbar">
    <div class="shell">
      <span>Dokumentation</span>
      <span class="docs-version">{site.version}</span>
    </div>
  </div>
  <div class="shell docs-layout">
    <aside class="docs-sidebar">
      <nav aria-label="Dokumentation">
        {docsNavigation.map((group) => (
          <div class="docs-nav-group">
            <h2>{group.label}</h2>
            {group.items.map((item) => (
              <a class:list={{ active: item.href === Astro.url.pathname }} href={item.href}>{item.label}</a>
            ))}
          </div>
        ))}
      </nav>
      <div class="sidebar-note">
        <strong>Etwas unklar?</strong>
        <p>Hilf mit, die Dokumentation besser zu machen.</p>
        <a href={`${site.repository}/issues`}>GitHub Issue öffnen <Icon name="external" size={14} /></a>
      </div>
    </aside>
    <article class="docs-content">
      <header class="docs-heading">
        <p class="eyebrow">NodeSentinel Dokumentation</p>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <div class="prose">
        <slot />
      </div>
      <nav class="page-navigation" aria-label="Seiten-Navigation">
        {previous ? <a href={previous.href}><span>Zurück</span><strong>{previous.label}</strong></a> : <span></span>}
        {next ? <a class="next" href={next.href}><span>Weiter</span><strong>{next.label}</strong></a> : null}
      </nav>
    </article>
  </div>
</BaseLayout>
