---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { site } from '../data/site';
---

<BaseLayout title="NodeSentinel – Monitoring für dein Homelab" description="Selbst gehostetes Linux-Monitoring für CPU, RAM, Temperaturen, Docker, Sicherheit und Benachrichtigungen. Einfache Installation per Docker oder nativ.">
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="release-pill"><span></span>Open Source · Self-hosted · {site.version}</div>
        <p class="eyebrow">Ein Dashboard. Alle deine Systeme.</p>
        <h1>Dein Homelab.<br /><span>Ein klares Bild.</span></h1>
        <p class="hero-lead">NodeSentinel überwacht deine Linux-Systeme, Container und Erreichbarkeit – ohne Cloud-Zwang und mit allen Daten unter deiner Kontrolle.</p>
        <div class="hero-actions">
          <a class="button" href="/docs/schnellstart/">Jetzt installieren <Icon name="arrow" /></a>
          <a class="button button--secondary" href={site.repository}><Icon name="github" />Auf GitHub ansehen</a>
        </div>
        <div class="hero-proof">
          <span><Icon name="check" size={16} />AMD64 & ARM64</span>
          <span><Icon name="check" size={16} />Keine Telemetrie</span>
          <span><Icon name="check" size={16} />30 Tage Verlauf</span>
        </div>
      </div>
      <div class="dashboard-preview" aria-label="Darstellung des NodeSentinel Dashboards">
        <div class="preview-window">
          <div class="preview-topbar">
            <div class="window-dots"><i></i><i></i><i></i></div>
            <span>nodesentinel.local</span>
            <b>● LIVE</b>
          </div>
          <div class="preview-sidebar">
            <span class="preview-logo">N</span>
            <i class="active"></i><i></i><i></i><i></i><i></i>
          </div>
          <div class="preview-main">
            <div class="preview-heading"><div><span>ÜBERSICHT</span><strong>Guten Tag.</strong></div><button>+ Host</button></div>
            <div class="metric-cards">
              <div><span>CPU</span><strong>18<small>%</small></strong><svg viewBox="0 0 120 35"><path d="M0 26 12 22 24 25 36 13 48 18 60 8 72 15 84 11 96 17 108 5 120 9"/></svg></div>
              <div><span>Speicher</span><strong>6.2<small>GB</small></strong><svg viewBox="0 0 120 35"><path d="M0 28 14 25 28 26 42 20 56 22 70 17 84 18 98 12 120 14"/></svg></div>
              <div><span>Systeme</span><strong>8<small>/8</small></strong><p class="all-online">● Alle online</p></div>
            </div>
            <div class="preview-hosts">
              <div class="preview-card-title"><strong>Systeme</strong><span>Aktualisiert vor 4 s</span></div>
              {[
                ['HomeServer', 'online', '24%', '41°'],
                ['Docker-NAS', 'online', '38%', '37°'],
                ['Pi-Gateway', 'online', '12%', '48°'],
                ['Backup-Node', 'online', '5%', '35°'],
              ].map(([name, status, cpu, temp]) => (
                <div class="host-row"><span class="status-dot"></span><div><strong>{name}</strong><small>{status}</small></div><div class="tiny-bars"><i style={`height:${cpu}`}></i><i style={`height:${temp}`}></i></div><b>{cpu}</b><b>{temp}</b><span class="kebab">•••</span></div>
              ))}
            </div>
          </div>
        </div>
        <div class="floating-alert"><span><Icon name="bell" size={18} /></span><div><strong>Alles im grünen Bereich</strong><small>Alle acht Systeme sind erreichbar</small></div></div>
      </div>
    </div>
  </section>

  <section class="stats-strip">
    <div class="shell">
      <div><strong>30</strong><span>Tage Historie</span></div>
      <div><strong>15 s</strong><span>Auto-Refresh</span></div>
      <div><strong>7+</strong><span>Alarmkanäle</span></div>
      <div><strong>0</strong><span>Cloud-Dienste nötig</span></div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading centered">
        <p class="eyebrow">Alles Wichtige im Blick</p>
        <h2>Monitoring ohne Ballast.</h2>
        <p>Fokussiert auf das, was Homelabs, kleine Server und persönliche Infrastruktur wirklich brauchen.</p>
      </div>
      <div class="feature-grid">
        <article class="feature-card feature-card--wide">
          <span class="feature-icon"><Icon name="chart" size={24} /></span>
          <h3>Systemmetriken in Echtzeit</h3>
          <p>CPU, RAM, Dateisystem, Temperaturen, Netzwerk, Datenträger und mehr. Ressourcenverläufe bleiben 30 Tage verfügbar.</p>
          <div class="mini-chart"><svg viewBox="0 0 600 140" preserveAspectRatio="none"><defs><linearGradient id="fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#62e89b" stop-opacity=".3"/><stop offset="1" stop-color="#62e89b" stop-opacity="0"/></linearGradient></defs><path class="area" d="M0 100 40 88 80 95 120 60 160 74 200 36 240 62 280 53 320 70 360 42 400 58 440 30 480 45 520 22 560 40 600 15V140H0Z"/><path class="line" d="M0 100 40 88 80 95 120 60 160 74 200 36 240 62 280 53 320 70 360 42 400 58 440 30 480 45 520 22 560 40 600 15"/></svg></div>
        </article>
        <article class="feature-card">
          <span class="feature-icon"><Icon name="box" size={24} /></span>
          <h3>Docker verstehen</h3>
          <p>Containerstatus, Restarts, Laufzeiten sowie CPU-, RAM- und Netzwerkverbrauch pro Container.</p>
          <div class="container-list"><span><i class="running"></i>nginx-proxy <b>Running</b></span><span><i class="running"></i>home-assistant <b>Running</b></span><span><i class="paused"></i>postgres <b>2 Restarts</b></span></div>
        </article>
        <article class="feature-card">
          <span class="feature-icon"><Icon name="bell" size={24} /></span>
          <h3>Alarme, die ankommen</h3>
          <p>Telegram, Discord, Ntfy, Pushover, E-Mail, Webhook oder Gotify – einzeln oder parallel.</p>
          <div class="notification-stack"><span>Telegram</span><span>Discord</span><span>Ntfy</span><span>+4</span></div>
        </article>
        <article class="feature-card feature-card--wide">
          <span class="feature-icon"><Icon name="shield" size={24} /></span>
          <h3>Sicherheit ohne Umwege</h3>
          <p>UFW- und Fail2Ban-Status, SSH-Ereignisse, optionale SMART-Prüfung sowie verschlüsselte und authentifizierte Agent-Verbindungen.</p>
          <div class="security-items"><span><Icon name="check" size={16} />Eigene Agent-Schlüssel</span><span><Icon name="check" size={16} />TLS & Zertifikatsprüfung</span><span><Icon name="check" size={16} />Minimale Rechte</span></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section install-section">
    <div class="shell install-grid">
      <div>
        <p class="eyebrow">In wenigen Minuten online</p>
        <h2>So einfach wird NodeSentinel installiert.</h2>
        <p>Wähle Docker Compose für den schnellsten Einstieg oder installiere die kompilierten Go-Binaries nativ unter systemd.</p>
        <ol class="install-steps">
          <li><span>1</span><div><strong>Dashboard einrichten</strong><small>Konfiguration laden, Passwort setzen, starten.</small></div></li>
          <li><span>2</span><div><strong>Agenten verbinden</strong><small>Auf jedem zu überwachenden Host installieren.</small></div></li>
          <li><span>3</span><div><strong>Alarme konfigurieren</strong><small>Grenzwerte und bevorzugte Kanäle wählen.</small></div></li>
        </ol>
        <a class="text-link" href="/docs/docker/">Zur Docker-Anleitung <Icon name="arrow" size={18} /></a>
      </div>
      <div class="terminal-card">
        <div class="terminal-title"><span></span><span></span><span></span><b>installation</b></div>
        <CodeBlock title="bash" code={`git clone https://github.com/TheArchitect998/NodeSentinel.git
cd NodeSentinel
cp nodesentinel.config.example.json nodesentinel.config.json

docker compose pull
docker compose run --rm dashboard \\
  /usr/local/bin/nodesentinel dashboard setup
docker compose up -d`} />
        <div class="terminal-success"><Icon name="check" size={18} /><span>Dashboard bereit unter <code>http://localhost:8888</code></span></div>
      </div>
    </div>
  </section>

  <section class="section roadmap-preview-section">
    <div class="shell roadmap-preview-grid">
      <div>
        <p class="eyebrow">Roadmap</p>
        <h2>Heute solide.<br />Morgen noch näher dran.</h2>
        <p>NodeSentinel bleibt bewusst selbst gehostet und wird Schritt für Schritt um bessere Verläufe, sichere Backups, native Apps und mehr Komfort erweitert.</p>
        <a class="button button--secondary" href="/roadmap/">Roadmap ansehen <Icon name="arrow" /></a>
      </div>
      <div class="roadmap-preview-items">
        <article><span>01</span><div><strong>Flackerfreie Live-Ansicht</strong><small>Stabile Aktualisierung mit erhaltenem Bedienzustand</small></div><b class="status-planned">Geplant</b></article>
        <article><span>02</span><div><strong>Native Desktop-Apps</strong><small>Windows, Linux und Android als sichere Alternative</small></div><b class="status-planned">Geplant</b></article>
        <article><span>03</span><div><strong>Backups und Aufbewahrung</strong><small>Konfigurierbare Historie mit Wiederherstellung</small></div><b class="status-outlook">Ausblick</b></article>
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="shell cta-box">
      <div>
        <p class="eyebrow">Deine Infrastruktur. Deine Daten.</p>
        <h2>Bereit für einen klaren Überblick?</h2>
        <p>Starte in wenigen Minuten mit der ausführlichen Dokumentation.</p>
      </div>
      <a class="button" href="/docs/">Dokumentation öffnen <Icon name="arrow" /></a>
    </div>
  </section>
</BaseLayout>
